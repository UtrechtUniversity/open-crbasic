' fuzz-needs-siblings: crbasic -- from crbasic/FinApp_tester.CR6, needs its sibling .crb library files alongside this file to compile
' fuzz: seed=repo/FinApp_tester.CR6 ops=replace_argument+duplicate_line class=message_diff
Const CRLF = CHR(13) + CHR(10)
Const CR = CHR(13)
Const LF = CHR(10)

Public PTemp, Batt_volt

Public WDogTimer As Long
Public BenchWatchdogOff As Boolean = True


DataTable (StationStatus,1,-1)
	DataInterval (0,5,Min,10)
	Minimum (1,Batt_volt,FP2,False,False)
	Sample (1,PTemp,FP2)
EndTable

ConstTable(GlobalConfigTable)
	Const FinAppSDIAddress = "F"
	Const FinAppDetectorCount = 2
	Const FinAppDetectorFirstId = 2
  IncludeSection("ConstTable", "CPU:FinAppLib.crb")
EndConstTable

IncludeSection("Definitions", "CPU:FinAppLib.crb")


IncludeSection("Definitions", "CPU:BenchLib.crb")
IncludeSection("fuzz", "CPU:BenchLib.crb")

IncludeSection("Functions", "CPU:FinAppLib.crb")

Public DoStart As Boolean = False
Public DoStop As Boolean = False
Public DoKill As Boolean = False
Public DoProbe As Boolean = False
Public DoMaster As Boolean = False
Public DoDetectors As Boolean = False
Public DoWater As Boolean = False
Public DoSample As Boolean = False
Public DoState As Boolean = False
Public DoAddressScan As Boolean = False
Public DoDetectorScan As Boolean = False
Public DoRepeatCycles As Boolean = False
Public DoLinkMonitor As Boolean = False

Public RepeatCycles As Long = 5
Public RepeatGapSecs As Long = 30
Public MonitorPolls As Long = 40
Public MonitorGapSecs As Long = 5

Public MonitorOk As Long
Public MonitorFail As Long
Public MonitorLongestFailRun As Long
Public DetectorScanGapSecs As Long = 3

Dim MonitorLast As Boolean

Dim RepeatI As Long
Dim RepeatNewCount As Long

Public FinAppScanInfo As String * 60
Dim FinAppScanRaw(FinAppDetectorValues)

Public LastResult As Boolean
Public StopSeconds As Long

Const FinAppAddressAlphabet = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"

Dim MenuKey As String * 2
Dim MenuPending As Boolean

Const StopTimer = 1
Const TimerResetAndStart = 2
Const TimerReadOnly = 4

Sub ShowState
	Dim N As Long

	LogDebug("power=" + FormatLong(FinApp_Powered,"%d") _
	         + " responding=" + FormatLong(FinApp_Responding,"%d") _
	         + " newdata=" + FormatLong(FinApp_NewData,"%d") _
	         + " ok(m/d/w)=" + FormatLong(FinApp_MasterOk,"%d") + "/" + FormatLong(FinApp_DetectorsOk,"%d") + "/" + FormatLong(FinApp_WaterOk,"%d") _
	         + " unsafestops=" + FormatLong(FinApp_UnsafeStops,"%d") _
	         + " stoppolls=" + FormatLong(FinApp_StopPollsUsed,"%d"))
	LogDebug("ident=[" + FinApp_Ident + "]")
	LogDebug("master  cnt=" + FormatFloat(FinApp_MasterCounter,"%.0f") _
	         + " batt=" + FormatFloat(FinApp_Batt_V,"%.3f") + "V" _
	         + " press=" + FormatFloat(FinApp_Pressure_Pa,"%.0f") + "Pa" _
	         + " boardtemp=" + FormatFloat(FinApp_BoardTemp_C,"%.3f") + "C")
	For N = 1 To FinAppDetectorCount
	LogDebug(" 8  SampleFinApp             all three, sets FinApp_NewData")
	LogDebug(" 9  show state")
	LogDebug(" 0  address scan             aI! on 0-9 and A-Z, ~35 s, probe must be powered")
	LogDebug(" A  detector scan            aMN!/D0! for N=1..9, finds fitted detector IDs")
	LogDebug(" B  repeat sample cycles     RepeatCycles x SampleFinApp, RepeatGapSecs apart")
	LogDebug(" C  link monitor             MonitorPolls x I!, measures busy-period length")
	LogDebug("==============================================")
	LogDebug("send a key (ENTER redisplays this menu)")
EndSub

Sub PollMenu
	MenuKey = ReadMenuKey()
	If MenuKey = "" Then ExitSub

	Select Case MenuKey
		Case "1"
			DoProbe = True
		Case "2"
			DoStart = True
		Case "3"
			DoStop = True
		Case "4"
			DoKill = True
		Case "5"
			DoMaster = True
		Case "6"
			DoDetectors = True
		Case "7"
			DoWater = True
		Case "8"
			DoSample = True
		Case "9"
			DoState = True
		Case "0"
			DoAddressScan = True
		Case "A"
			DoDetectorScan = True
		Case "B"
			DoRepeatCycles = True
		Case "C"
			DoLinkMonitor = True
		Case Else
			Call ShowMenu
			ExitSub
	EndSelect

	LogDebug("")
	LogDebug(">>> option " + MenuKey + " selected")
	MenuPending = True
EndSub

BeginProg
	LogDebug("")
	LogDebug("FinAppLib tester starting")
	SerialFlush(ComUSB)
	Call ShowMenu

	Scan (5,Sec,0,0)
		If BenchWatchdogOff Then
			WDogTimer = WatchdogTimer(0,Sec)
		Else
			WDogTimer = WatchdogTimer(10,Min)
		EndIf

		PanelTemp (PTemp,15000)
		Battery (Batt_volt)

		Call PollMenu

		If DoProbe Then
			DoProbe = False
			LastResult = ProbeFinApp()
			LogDebug("ProbeFinApp -> " + FormatLong(LastResult,"%d") + "  ident=[" + FinApp_Ident + "]")
		EndIf

		If DoStart Then
			DoStart = False
			LastResult = StartFinApp()
			LogDebug("StartFinApp -> " + FormatLong(LastResult,"%d") _
			         + "  (settled " + FormatLong(FinAppPowerSettleSecs,"%d") + "s, power now " _
			         + FormatLong(FinApp_Powered,"%d") + ")")
		EndIf

		If DoStop Then
			DoStop = False
			Timer(StopTimer,Sec,TimerResetAndStart)
			LastResult = StopFinApp()
			StopSeconds = Timer(StopTimer,Sec,TimerReadOnly)
			LogDebug("StopFinApp -> " + FormatLong(LastResult,"%d") _
			         + "  polls=" + FormatLong(FinApp_StopPollsUsed,"%d") _
