	DataInterval (0,5,Min,10)
	Minimum (1,Batt_volt,FP2,False,False)
	Sample (1,PTemp,FP2)
EndTable

ConstTable(GlobalConfigTable)
  Const CommsRailPort = SW12_2
  IncludeSection("ConstTable", "CPU:SBDIridiumLib.crb")
EndConstTable

IncludeSection("Definitions", "CPU:SBDIridiumLib.crb")


IncludeSection("Definitions", "CPU:BenchLib.crb")
IncludeSection("Functions", "CPU:BenchLib.crb")
