' fuzz-needs-siblings: crbasic -- from crbasic/TString_tester.CR6, needs its sibling .crb library files alongside this file to compile
' fuzz: seed=repo/TString_tester.CR6 ops=insert_whitespace+toggle_two_word class=message_diff
Const CRLF = CHR(13) + CHR(10)
Const CR = CHR(13)
Const LF = CHR(10)

Public PTemp, Batt_volt

Public WDogTimer As Long
Public BenchWatchdogOff As Boolean = True


DataTable (StationStatus,1,-1)
	DataInterval (0,5,Min,10)
	Minimum (1,Batt_volt,FP2,False,False)
	Sample (1,PTemp,FP2)
EndTable

ConstTable(GlobalConfigTable)
	Const TStringCount = 48
	Const LowPowerRailMask = &B10
	Const LowPowerSettleSecs = 10
  IncludeSection("ConstTable", "CPU:GeoPrecisionTStringLib.crb")
EndConstTable

IncludeSection("Definitions", "CPU:GeoPrecisionTStringLib.crb")


IncludeSection("Definitions", "CPU:BenchLib.crb")
IncludeSection("Functions", "CPU:BenchLib.crb")
IncludeSection("Rail", "CPU:BenchLib.crb")

IncludeSection("Functions", "CPU:GeoPrecisionTStringLib.crb")

Const ReportTimer = 1
Const TimerResetAndStart = 2
Const TimerReadOnly = 4

Public TStringInfo As String * 100
Public LastResult As Boolean
Public LastElapsedMs As Long
Public RepeatRead As Boolean = False

Public DoReadCRC As Boolean = False
Public DoReadNoCRC As Boolean = False
Public DoSupply As Boolean = False
Public DoIdentify As Boolean = False
Public DoDeviceInfo As Boolean = False
Public DoAddressScan As Boolean = False
Public DoShowConfig As Boolean = False
Public DoToggleRail As Boolean = False

Dim MenuKey As String * 2
Dim MenuPending As Boolean

Sub LogTStringStats
	Dim I As Long
	Dim V As Float
	Dim MinV As Float
	Dim MaxV As Float
	Dim SumV As Float
	Dim NValid As Long

	MinV = NAN
	MaxV = NAN
	SumV = 0
	NValid = 0

	For I = 1 To TStringCount
		V = TString_Temp_C(I)
		If (V <> NAN) AND (V >= TStringErrorLimit) Then
			NValid = NValid + 1
